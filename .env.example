# ---- mode ----
TENLY_MODE=live                      # local = in-memory fakes for Gnani/WhatsApp/Sheets (tests, rehearsal)
PUBLIC_BASE_URL=https://tenly-rails.vercel.app
ADMIN_KEY=change-me                  # testers only: /mock/* console
MEDIA_SIGNING_SECRET=change-me

# ---- MCP connector keys (enter the same value in AgenticOrg's "Api Key" field per connector) ----
MCP_KEY_SHEETS=change-me
MCP_KEY_GNANI=change-me
MCP_KEY_WAUI=change-me
MCP_KEY_DLV=change-me
MCP_KEY_P3P=change-me
MCP_KEY_CAPS=change-me

# ---- REST mock keys (what a Delhivery / P3P client would send) ----
DLV_MOCK_KEY=change-me
P3P_MOCK_KEY=change-me
CAPS_KEY=change-me

# ---- real tools ----
GNANI_API_KEY=
WA_TOKEN=                            # Meta permanent system-user token
WA_PHONE_NUMBER_ID=
META_APP_SECRET=                     # for X-Hub-Signature-256
META_VERIFY_TOKEN=change-me          # any string; paste the same in Meta's webhook setup
SHEET_ID=
GOOGLE_SA_JSON=                      # the whole service-account JSON on one line

# ---- state (Vercel KV / Upstash) ----
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- demo parties: real WhatsApp only for numbers in WA_LIVE_NUMBERS; others are simulated on /console ----
DEMO_TENANT_MSISDN=919000000001
DEMO_TENANT_LANG=hi
DEMO_OWNER_MSISDN=
DEMO_TRADESMAN_MSISDN=
WA_LIVE_NUMBERS=

# ---- optional: start AgenticOrg runs directly (needs an org API key). Without it, the relay
# ---- writes events to the Sheet's Inbox tab and the agent's schedule processes them.
AGENTICORG_RUN_URL=
AGENTICORG_API_KEY=
GRANT_MAX_TXN_PAISE=400000
CALL_HOURS_ENFORCE=true
